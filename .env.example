# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for links in confirmation emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Used by /api/checkout to write orders. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mailgun: Dashboard > Sending > Domain settings / API keys
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM="GraceBites <orders@mg.yourdomain.com>"
# Use https://api.eu.mailgun.net if your Mailgun domain is in the EU region
MAILGUN_API_URL=https://api.mailgun.net
